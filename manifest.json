{
  "manifest_version": 2,
  "name": "Tab Volume",
  "version": "1.3.1",
  "description": "Adds volume control to your tabs.",
  "homepage_url": "https://github.com/mg2239/volume",
  "browser_specific_settings": {
    "gecko": {
      "id": "{a8e99fca-eb8f-410f-84e9-142eb055c162}",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "96": "src/assets/icon-light.svg"
  },
  "browser_action": {
    "default_icon": "src/assets/icon-light.svg",
    "theme_icons": [
      {
        "light": "src/assets/icon-light.svg",
        "dark": "src/assets/icon-dark.svg",
        "size": 96
      }
    ],
    "default_title": "Tab Volume",
    "default_popup": "src/index.html"
  },
  "background": {
    "scripts": ["src/background.js"]
  },
  "permissions": ["activeTab", "storage"],
  "optional_permissions": ["<all_urls>"]
}
